# Express live-feed server
PORT=3001
TOKEN_MINT=
GRAD_SOL=85
BIG_SOL=0.5
MICRO_SOL=0.05

# Set when hosting the frontend and server on separate origins
SITE_ORIGIN=http://localhost:5173
VITE_BACKEND_URL=

# Optional live chain data. Keep the RPC URL server-side.
SOLANA_RPC_URL=
# Optional backup; defaults to this shared public endpoint.
SOLANA_RPC_FALLBACK_URL=https://solana-rpc.publicnode.com

# Optional contract-address sync/update
CA_UPDATE_TOKEN=replace-with-a-long-random-secret
CA_SOURCE_URL=

# Optional generated dialogue providers
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Frontend branding; these VITE_ values are public at build time
VITE_TOKEN_NAME=A.R.C.H.I.E.
VITE_TOKEN_SYMBOL=ARCHIE
