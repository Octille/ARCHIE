# Leave TOKEN_MINT empty to start idle with no CA or simulated trades
TOKEN_MINT=
# Frontend branding (keep the symbol/name aligned with the launched coin)
VITE_TOKEN_NAME=A.R.C.H.I.E.
VITE_TOKEN_SYMBOL=ARCHIE
# Optional URL of separately hosted Express/WebSocket feed server for production
VITE_BACKEND_URL=
# Free key from console.groq.com. Without it, ARCHIE uses built-in scripted lines.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional backup provider when Groq is rate limited. Keep its key server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Bearer token required for POST /api/ca. Generate with: openssl rand -hex 32
CA_UPDATE_TOKEN=
# Optional on a separately hosted feed server: sync CA from Netlify's public GET /api/ca
CA_SOURCE_URL=
GRAD_SOL=85
BIG_SOL=0.5
MICRO_SOL=0.05
PORT=3001
